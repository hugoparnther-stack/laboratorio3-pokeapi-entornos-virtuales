# Copia este archivo como ".env" y ajusta los valores si hace falta.
# El archivo .env real NO se sube a GitHub (está en el .gitignore).

# URL base de la API pública
API_BASE_URL=https://pokeapi.co/api/v2

# Segundos de espera máxima por respuesta
API_TIMEOUT=10

# Ruta de la base de datos local (relativa a la raíz del proyecto)
DB_PATH=data/pokedex.db
